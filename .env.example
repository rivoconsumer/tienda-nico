# ─────────────────────────────────────────────────────────────
#  Configuración de la tienda. Copiá este archivo como ".env"
#  y completá los valores. Nunca subas el .env a internet.
# ─────────────────────────────────────────────────────────────

# Puerto donde corre el servidor
PORT=3000

# Dirección pública de la tienda (con https), sin barra al final.
# Hace falta en producción para que Mercado Pago pueda avisar los pagos.
# Ejemplo: PUBLIC_URL=https://www.tutienda.com.ar
PUBLIC_URL=

# Contraseña del panel de administración (/admin).
# Si la dejás vacía, se genera una temporal en cada arranque y se muestra en la consola.
ADMIN_PASSWORD=

# Clave para firmar la sesión del panel. Poné un texto largo y aleatorio.
SESSION_SECRET=

# ── Mercado Pago ──────────────────────────────────────────────
# Access Token de tu aplicación: https://www.mercadopago.com.ar/developers/panel/app
# Para probar usá el de "Credenciales de prueba" (empieza con TEST-).
# Si lo dejás vacío, la tienda funciona en MODO DEMO (los pagos se simulan).
MP_ACCESS_TOKEN=

# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta).
# Opcional, pero recomendada: valida que los avisos vengan de Mercado Pago.
MP_WEBHOOK_SECRET=

# Texto que aparece en el resumen de la tarjeta (opcional, sin tildes, máx. 13 letras)
MP_STATEMENT_DESCRIPTOR=

# Máximo de cuotas a ofrecer en el checkout (0 = lo que tengas configurado en Mercado Pago)
MP_MAX_INSTALLMENTS=0

# ── Avanzado ──────────────────────────────────────────────────
# Carpeta donde se guardan la base de datos y las imágenes subidas
DATA_DIR=data

# Si la tienda corre detrás de un proxy (Railway, Render, Nginx), poné 1
TRUST_PROXY=

# Zona horaria para los reportes del panel
STORE_TIMEZONE=America/Argentina/Buenos_Aires

# Ponelo en "production" cuando publiques la tienda
NODE_ENV=
